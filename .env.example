# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me-with-your-token

# Comma-separated Telegram user IDs allowed to use /backup and /broadcast
ADMIN_IDS=123456789

# SQLite database path (relative to the project or absolute)
DB_PATH=rpg.db

# Directory for admin backups
BACKUP_DIR=backups

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

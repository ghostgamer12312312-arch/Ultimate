# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me-with-your-token

# Comma-separated Telegram user IDs allowed to use admin commands
ADMIN_IDS=123456789

# Optional: private group/chat that receives /query reports
QUERY_GROUP_ID=

# SQLite database path (relative to the project or absolute)
ULTIMATE_DB_PATH=ultimate.db

# Directory for admin backups
ULTIMATE_BACKUP_DIR=backups/ultimate

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
